# 複製為 .env 或貼到 Cursor MCP 的 env（勿將含真實金鑰的檔案提交版本庫）

# --- LLM 後端：cursor_agent（預設）或 openai ---
# BROWSER_USE_MCP_LLM=cursor_agent
# BROWSER_USE_MCP_LLM=openai

# 是否重用 Cursor agent 對話（--resume），預設開；若行為異常可關閉後重試
# BROWSER_USE_CURSOR_AGENT_RESUME=0

# 當 agent 僅回 Markdown／說明、未附 AgentOutput JSON 時，是否自動包成 done（預設開）
# BROWSER_USE_CURSOR_AGENT_PLAINTEXT_FALLBACK=0

# --- cursor_agent：`agent --model`（預設 auto）---
# BROWSER_USE_CURSOR_AGENT_MODEL=auto
# 或與 Cursor CLI 一致的名稱：
# CURSOR_AGENT_MODEL=auto
# 其他範例：sonnet-4、gpt-5（以 `agent --list-models` 為準）
# 若設為空白字串則不傳 `--model`（交由 agent 內建預設）
# 非互動：程式會自動為 agent 加上 `--yolo` 與 `--trust`（搭配 --print），略過 workspace 確認等提示

# 改為「單一長駐 Node + @cursor/sdk」多步 send（不再每步 exec agent CLI）：
# 1) 在專案 node/ 執行 npm install
# 2) 設定 Dashboard Integrations 的 API Key（與 agent login 不同）
# BROWSER_USE_CURSOR_AGENT_TRANSPORT=sdk_stdio
# CURSOR_API_KEY=your-key
# sdk_stdio 時：BROWSER_USE_CURSOR_AGENT_MODEL=auto（或空白）會對應成 SDK 的 default（@cursor/sdk 不接受字串 auto）

# 可選：Node 執行檔路徑
# NODE_BIN=node

# --- OpenAI 相容（BROWSER_USE_MCP_LLM=openai 時）---
# BROWSER_USE_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# BROWSER_USE_OPENAI_API_KEY=sk-local-or-any
# BROWSER_USE_OPENAI_MODEL=your-model-id
# BROWSER_USE_OPENAI_TEMPERATURE=0.2

# 亦支援標準名稱：OPENAI_BASE_URL、OPENAI_API_KEY、OPENAI_MODEL

# --- 瀏覽器：是否顯示 Chromium 視窗（僅 MCP env，非工具參數；預設關閉＝無頭）---
# BROWSER_USE_MCP_DEBUG=1

# 跨網域導航時 CDP「頁面就緒」輪詢秒數（browser-use 內建預設 8）；慢站可加大，例如 20
# BROWSER_USE_MCP_PAGE_READINESS_TIMEOUT_SEC=20

# --- 逾時：每步（含 LLM + 瀏覽器）預設 600 秒；browser-use 內建為 180，cursor_agent 易超時 ---
# BROWSER_USE_MCP_STEP_TIMEOUT_SEC=900

# --- 逾時：單次 LLM 呼叫（Agent.llm_timeout）---
# BROWSER_USE_MCP_LLM_TIMEOUT_SEC=600

# --- 可選 ---
# CURSOR_AGENT_CMD=agent
